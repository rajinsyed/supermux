// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = cmux
// SUPERMUX:begin ios-supermux-brand
// Home-screen name of the fork's iOS app. PRODUCT_NAME stays `cmux` — it names
// the built product (cmux.app) that every reload/install script resolves by
// path, so renaming it would break them. Only the user-visible
// CFBundleDisplayName is rebranded. Release.xcconfig overrides this again for
// its own channel suffix.
// SUPERMUX_IOS_DISPLAY_SUFFIX is the sanctioned per-build name tag: dogfood
// Release builds pass SUPERMUX_IOS_DISPLAY_SUFFIX=" <tag>" (leading space
// included) on the xcodebuild command line so parallel phone installs are
// tellable apart (e.g. "Supermux notification-redesign") without ever passing
// PRODUCT_DISPLAY_NAME itself. Empty by default, so official builds stay
// exactly "Supermux".
SUPERMUX_IOS_DISPLAY_SUFFIX =
PRODUCT_DISPLAY_NAME = Supermux$(SUPERMUX_IOS_DISPLAY_SUFFIX)
// SUPERMUX:end ios-supermux-brand
// SUPERMUX:begin ios-communication-notifications
// Per-target signing identity, indirected through SUPERMUX_* variables.
//
// This indirection is load-bearing, not style. An xcodebuild command-line build
// setting applies to EVERY target in the workspace, so once a notification
// service extension exists, the release script's
// `PRODUCT_BUNDLE_IDENTIFIER=com.supermux.ios`,
// `PROVISIONING_PROFILE_SPECIFIER=…`, and
// `CODE_SIGN_ENTITLEMENTS=Config/supermux.entitlements` would all be stamped
// onto the extension too — giving it the APP's bundle id (iOS refuses to load
// an extension whose id is not a child of its container) and the app's APNs
// entitlement (which its own App ID does not carry). The script sets these
// SUPERMUX_* variables instead, and each target reads only its own.
//
// The extension's id derives from the app's so it follows every override
// automatically; hardcoding it would strand the extension under the default id
// on every release and dogfood build.
SUPERMUX_APP_BUNDLE_ID = dev.cmux.ios
SUPERMUX_NSE_BUNDLE_ID = $(SUPERMUX_APP_BUNDLE_ID).notification-service
PRODUCT_BUNDLE_IDENTIFIER = $(SUPERMUX_APP_BUNDLE_ID)

// Per-target signing inputs. Empty here so ordinary Xcode/simulator builds keep
// using automatic signing; scripts/supermux-ios-release.sh sets them for the
// manual-signing Release pass.
SUPERMUX_APP_DEV_PROFILE_SPECIFIER =
SUPERMUX_NSE_DEV_PROFILE_SPECIFIER =

// The extension's OWN entitlements — never the app's. It needs exactly one
// capability: the app group holding project icon PNGs, which is the only way a
// push banner can show a real project logo (APNs caps a payload at 4096 bytes,
// an order of magnitude under a real icon, and the extension cannot open the
// app's RPC session). Inheriting the app's file would claim aps-environment and
// Communication Notifications, which the extension's App ID does not carry, and
// signing would fail.
SUPERMUX_NSE_CODE_SIGN_ENTITLEMENTS = Config/supermux-notification-service.entitlements
// SUPERMUX:end ios-communication-notifications
// User-visible versions (CFBundleShortVersionString). Keep beta and production
// independent: TestFlight can stay on the already-approved beta version while
// the first production App Store upload starts from its own release version.
// Semver X.Y.Z; CFBundleVersion (CURRENT_PROJECT_VERSION) is the monotonic build
// id stamped by ios/scripts/upload-testflight.sh on upload.
CMUX_IOS_BETA_MARKETING_VERSION = 1.0.4
CMUX_IOS_APPSTORE_MARKETING_VERSION = 1.0.0
MARKETING_VERSION = $(CMUX_IOS_BETA_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = 1

// Dev-build identity, surfaced in-app (Settings > About) so a DEBUG dogfood
// build is tellable. Empty by default, so release/TestFlight builds show a clean
// "1.0.0". ios/scripts/reload.sh overrides these on the xcodebuild command line
// with the short git SHA and the --tag, and Config/Info.plist maps them to the
// CMUXGitSHA / CMUXDevTag Info.plist keys that AppVersionInfo reads.
CMUX_GIT_SHA =
CMUX_DEV_TAG =

// Per-developer presence/paired-Mac-backup worker override, baked into the
// CMUXPresenceBaseURL Info.plist key so a normally-tapped dev device build (which
// sees no shell env) talks to an isolated worker instead of the shared
// cmux-presence-dev. Empty by default (release/TestFlight resolve to nil/disabled
// or the Debug default). ios/scripts/reload.sh overrides it from
// $CMUX_PRESENCE_BASE_URL. See workers/presence/scripts/deploy-dev.sh and
// PresenceServiceConfiguration.resolvedServiceBaseURL.
CMUX_PRESENCE_BASE_URL =

// Auth-environment override, baked into the CMUXAuthEnvironment Info.plist key
// so a normally-tapped dev device build (no shell env) can sign in against the
// PRODUCTION Stack project when testing production-account behavior. Build
// compatibility remains separate: a tagged DEV iOS build may connect only to
// the same tagged DEV Mac build. Empty by default (DEBUG -> development,
// Release -> production). ios/scripts/reload.sh --prod-auth sets it to
// "production". Keep the Info.plist key name in sync with
// MobileAuthComposition.authEnvironmentInfoPlistKey.
CMUX_IOS_AUTH_ENV =

// Tagged reloads bake the matching macOS tag's isolated web origin here.
// Empty normal builds retain AuthConfig's channel default.
CMUX_API_BASE_URL =

// Iroh trust-broker origin, independent of the general app API. Tagged dev
// reloads bake shared staging here so parallel Mac/iOS lanes can discover one
// another without moving their local feature APIs. Empty release builds fall
// back to AuthConfig's production API origin.
CMUX_IROH_BROKER_BASE_URL =

// Crash reporting stays enabled for development and TestFlight. The official
// App Store lane overrides this to NO until its consent lifecycle is proven.
CMUX_CRASH_REPORTING_ENABLED = YES

// ==========================================
// Platform Configuration
// ==========================================
// Keep >= 18.0: every cmux iOS Swift package declares .iOS(.v18), so a lower
// app target fails the build. The ITMS-90208 rejections that motivated the
// brief 18.0/17.5 lowering were caused by an embedded static-archive
// Iroh.framework (stripped in ios/scripts/upload-testflight.sh), not by this
// value.
IPHONEOS_DEPLOYMENT_TARGET = 18.4

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_NSCameraUsageDescription = Scan cmux pairing QR codes from your Mac terminal.

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/cmux.entitlements to add capabilities
// SUPERMUX:begin ios-communication-notifications
// Read by the APP target as $(SUPERMUX_APP_CODE_SIGN_ENTITLEMENTS). The
// notification service extension pins CODE_SIGN_ENTITLEMENTS empty on its own
// target — it needs none, and inheriting the app's would claim an APNs
// entitlement its App ID does not carry. Defaulted to upstream's file so an
// ordinary build resolves exactly as before; only the release script overrides.
SUPERMUX_APP_CODE_SIGN_ENTITLEMENTS = Config/cmux.entitlements
CODE_SIGN_ENTITLEMENTS = $(SUPERMUX_APP_CODE_SIGN_ENTITLEMENTS)
// SUPERMUX:end ios-communication-notifications

// ==========================================
// Pairing URL scheme (channel-specific)
// ==========================================
// The cmux pairing/attach deep-link scheme this build registers in
// CFBundleURLTypes (Config/Info.plist). Channel-specific so the system Camera
// app can never hand a beta/prod pairing QR to a dev build that also claimed
// the scheme: dev (Debug/tagged) builds register cmux-ios-dev, Release
// (TestFlight beta + App Store) overrides this to cmux-ios in
// Release.xcconfig. The default here is the dev scheme so an unknown build
// configuration can never hijack release links. Keep both values in sync with
// CmxPairingURLScheme in Packages/Shared/CMUXMobileCore.
CMUX_IOS_URL_SCHEME = cmux-ios-dev
