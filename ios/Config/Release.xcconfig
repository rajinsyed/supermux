// Release.xcconfig
// Release configuration for iOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

// SUPERMUX:begin ios-communication-notifications
// Set through SUPERMUX_APP_BUNDLE_ID so the notification service extension's
// id (SUPERMUX_NSE_BUNDLE_ID in Shared.xcconfig) stays derived from it and
// remains a child of the app's. Assigning PRODUCT_BUNDLE_IDENTIFIER directly
// here would silently detach the extension from this channel's id.
SUPERMUX_APP_BUNDLE_ID = dev.cmux.app.beta
// SUPERMUX:end ios-communication-notifications
DEVELOPMENT_TEAM = 7WLXT3NR37

// Shared.xcconfig brands all fork builds as Supermux. The upload scripts still
// override TestFlight/App Store display names on the xcodebuild command line.
// SUPERMUX:begin ios-supermux-brand
// Fork rebrand (see Shared.xcconfig). The upstream TestFlight/App Store lanes
// pass PRODUCT_DISPLAY_NAME on the xcodebuild command line
// (ios/scripts/upload-testflight.sh), so they still ship "cmux BETA"/"cmux" and
// tests/test_ios_testflight_pro_distribution.py is unaffected; this value only
// covers local Release builds, which is what fork dogfood installs. Dogfood
// tag builds append SUPERMUX_IOS_DISPLAY_SUFFIX (see Shared.xcconfig).
PRODUCT_DISPLAY_NAME = Supermux$(SUPERMUX_IOS_DISPLAY_SUFFIX)
// SUPERMUX:end ios-supermux-brand

// TestFlight/App Store builds use production APNs. Debug keeps
// Config/cmux.entitlements from Shared.xcconfig.
// SUPERMUX:begin ios-communication-notifications
// Set through the app-scoped variable (see Shared.xcconfig) so the notification
// service extension never inherits the app's production entitlements.
SUPERMUX_APP_CODE_SIGN_ENTITLEMENTS = Config/cmux-release.entitlements
// SUPERMUX:end ios-communication-notifications

// Release (TestFlight beta + App Store) pairing scheme. Dev builds register
// cmux-ios-dev instead, so the Camera app routes each channel's QR to the
// matching build. Keep in sync with CmxPairingURLScheme.release.
CMUX_IOS_URL_SCHEME = cmux-ios
