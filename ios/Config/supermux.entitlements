<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build-stage entitlement for the Apple Development profile. The final
	     installed app is RE-SIGNED Ad Hoc with aps-environment=production by
	     scripts/supermux-ios-release.sh; command-line distribution signing
	     cannot be used directly because workspace-wide build settings leak
	     into SwiftPM package targets, which cannot take a provisioning
	     profile. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Shared container the app mirrors project icon PNGs into so the
	     notification service extension can paint the real project logo on a push
	     banner. Both the app and the extension must carry the SAME group; the
	     extension's own file (supermux-notification-service.entitlements) is
	     kept to this key alone. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.supermux.ios</string>
	</array>
</dict>
</plist>
