    "supermux.zeron.acknowledgements.preamble": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Claude Code chat pane is a SwiftUI port of zeron/comet's chat pane. It redistributes the third-party material below under the licenses shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code のチャットペインは zeron/comet のチャットペインを SwiftUI に移植したものです。以下のサードパーティ素材を、表示されているライセンスのもとで再配布しています。"
          }
        }
      }
    },
